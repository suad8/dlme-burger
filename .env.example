# انسخ هذا الملف إلى .env وعبّئ القيم. لا تُضِف .env إلى Git.

# PostgreSQL — إلزامي
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mansha?schema=public"

# مفتاح المصادقة — إلزامي.
# ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠️ أي مفتاح يبدأ بـ dev-only يوقف الإقلاع في الإنتاج (حارس مقصود).
BETTER_AUTH_SECRET=""

# العنوان العام الكامل للتطبيق
BETTER_AUTH_URL="http://localhost:3000"

# المتغير الوحيد المكشوف للمتصفح — لا تضع أي سر ببادئة NEXT_PUBLIC_
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# مخزن الملفات — اتركه فارغًا للقرص المحلي (الافتراضي)
# STORAGE_PROVIDER=""
STORAGE_ROOT=".storage"

# بوابة الدفع — اتركه فارغًا للوضع الوهمي الذي لا يحصّل شيئًا
# BILLING_PROVIDER=""
