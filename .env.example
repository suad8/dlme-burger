# انسخ هذا الملف إلى .env وعبّئ القيم. لا تُضِف .env إلى Git.

# PostgreSQL — إلزامي
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mansha?schema=public"

# مفتاح المصادقة — إلزامي.
# ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠️ أي مفتاح يبدأ بـ dev-only يوقف الإقلاع في الإنتاج (حارس مقصود).
BETTER_AUTH_SECRET=""

# العنوان العام الكامل للتطبيق
BETTER_AUTH_URL="http://localhost:3000"

# المتغير الوحيد المكشوف للمتصفح — لا تضع أي سر ببادئة NEXT_PUBLIC_
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# مخزن الملفات — اتركه فارغًا للقرص المحلي (الافتراضي)
# STORAGE_PROVIDER=""
STORAGE_ROOT=".storage"

# للنشر متعدد النسخ: تخزين على S3 أو أي خدمة متوافقة (R2، MinIO…)
#   STORAGE_PROVIDER="s3"
#   S3_BUCKET="itqan-files"
#   S3_REGION="me-south-1"
#   S3_ACCESS_KEY_ID="..."          # سرّ خادم بحت
#   S3_SECRET_ACCESS_KEY="..."      # سرّ خادم بحت — لا يظهر في أي سجل
#   S3_SESSION_TOKEN=""             # لبيانات اعتماد مؤقّتة فقط
#   S3_ENDPOINT=""                  # لخدمة متوافقة غير AWS
#   S3_FORCE_PATH_STYLE="false"
# الملفات تبقى تُقدَّم عبر /api/files بروابطنا الموقّعة — لا نصدر روابط S3
# مباشرة، لأنها تتجاوز فحص الجلسة وملكية المنشأة.

# بوابة الدفع — اتركه فارغًا للوضع الوهمي الذي لا يحصّل شيئًا
# BILLING_PROVIDER=""

# لتفعيل التحصيل الحقيقي عبر ميسّر (mada وApple Pay وفوترة بالريال):
#   BILLING_PROVIDER="moyasar"
#   MOYASAR_SECRET_KEY="sk_live_..."      # سرّ الخادم — لا يُرسل إلى المتصفح أبدًا
#   MOYASAR_WEBHOOK_SECRET="whsec_..."    # يُوقَّع به الـwebhook ويُتحقق منه بمقارنة ثابتة الزمن
# بلا هذه المفاتيح يبقى الوضع الوهمي: تُسجَّل النية وتُنشأ فاتورة مسودة
# ولا يُحصَّل أي مبلغ، وتقول الواجهة ذلك صراحة.

# مزوّد البريد — اتركه فارغًا فلا تُرسل رسائل (الدعوة تعطي رابطًا يُنسخ يدويًا)
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_..."               # سرّ خادم بحت
# EMAIL_FROM="إتقان <no-reply@example.sa>"
# EMAIL_REPLY_TO="support@example.sa"   # اختياري
